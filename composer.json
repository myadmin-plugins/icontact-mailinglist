{
	"name": "detain/myadmin-icontact-mailinglist",
	"type": "myadmin-plugin",
	"description": "iContact mailing list integration plugin for the MyAdmin control panel, providing automated subscriber management and list synchronization via the iContact API.",
	"keywords": [
		"icontact",
		"mailing-list",
		"email",
		"newsletter",
		"myadmin",
		"plugin"
	],
	"license": "LGPL-2.1-only",
	"authors": [
		{
			"name": "Joe Huss",
			"homepage": "https://my.interserver.net/"
		}
	],
	"config": {
		"bin-dir": "vendor/bin",
		"minimum-stability": "dev",
		"allow-plugins": {
			"detain/myadmin-plugin-installer": true
		}
	},
	"require": {
		"php": ">=5.0.0",
		"ext-soap": "*",
		"symfony/event-dispatcher": "*@stable",
		"detain/myadmin-plugin-installer": "^2.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"Detain\\MyAdminIcontact\\": "src/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Detain\\MyAdminIcontact\\Tests\\": "tests/"
		}
	}
}
